# ===== 必填 =====
APP_URL=https://cokeai.cc.cd
POSTGRES_PASSWORD=replace-with-url-safe-random-password
APP_ENCRYPTION_KEY=replace-with-app-encryption-key
INTERNAL_API_SECRET=replace-with-internal-api-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
SUPPORT_EMAIL=support@cokeai.cc.cd

# ===== 计费与运营 =====
USD_CNY_RATE=7.20
REFERRAL_COMMISSION_BPS=1000
REFERRAL_HOLD_DAYS=7
API_REQUESTS_PER_MINUTE=60
API_CONCURRENCY_PER_USER=4
MAX_ACTIVE_API_KEYS=8
DEFAULT_MAX_OUTPUT_TOKENS=2048
HARD_MAX_OUTPUT_TOKENS=16384
SESSION_DAYS=14
DATABASE_POOL_SIZE=10

# ===== 支付（可先留空，使用人工确认） =====
MANUAL_PAYMENTS_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=cny

# ===== Cloudflare Tunnel（可选；启用 --profile tunnel 时必填） =====
CLOUDFLARE_TUNNEL_TOKEN=

# ===== n8n =====
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string
N8N_HOST=n8n.cokeai.cc.cd
N8N_PROTOCOL=https
N8N_SECURE_COOKIE=false
GENERIC_TIMEZONE=Asia/Shanghai
ALERT_WEBHOOK_URL=

# ===== Edge (Caddy) =====
# The edge listens on :8080 inside the container; only 127.0.0.1:EDGE_HOST_PORT
# is published on the host. Cloudflare Tunnel must point at http://edge:8080.
GATEWAY_UPSTREAM=sub2api:8080
APP_UPSTREAM=app:3000
EDGE_HOST_PORT=8080
CADDY_IMAGE=caddy:2-alpine
COKEAI_NETWORK=cokeai_net

# ===== Sub2API gateway =====
# PIN THIS IMAGE. Replace :latest with a release tag or an immutable digest
# (weishaw/sub2api@sha256:...) before the first production start.
SUB2API_IMAGE=weishaw/sub2api:latest
SUB2API_PORT=18080
SUB2API_RUN_MODE=standard
SUB2API_GROUP_ID=1

# Host scripts (verify/rollback) use the loopback mapping.
SUB2API_INTERNAL_URL=http://127.0.0.1:18080
# The app container reaches Sub2API by Docker service name.
SUB2API_CONTAINER_URL=http://sub2api:8080
SUB2API_TIMEOUT_MS=8000
SUB2API_USER_CONCURRENCY=4
SUB2API_USER_RPM=60

# First-run Sub2API admin. Changing these later does NOT overwrite an existing
# admin account. Use a real mailbox you control.
SUB2API_ADMIN_EMAIL=admin@example.com
SUB2API_ADMIN_PASSWORD=replace-with-a-strong-sub2api-admin-password

# Fixed secrets. Rotating JWT_SECRET invalidates admin sessions; rotating
# TOTP_ENCRYPTION_KEY invalidates existing 2FA enrollments.
SUB2API_JWT_SECRET=replace-with-sub2api-jwt-secret
SUB2API_JWT_EXPIRE_HOUR=24
SUB2API_TOTP_ENCRYPTION_KEY=replace-with-sub2api-totp-key

# Dedicated Sub2API PostgreSQL (option A, default) and Redis.
SUB2API_POSTGRES_IMAGE=postgres:18-alpine
SUB2API_REDIS_IMAGE=redis:8-alpine
SUB2API_DB_HOST=sub2api-postgres
SUB2API_DB_PORT=5432
SUB2API_DB_NAME=sub2api
SUB2API_DB_USER=sub2api
SUB2API_DB_PASSWORD=replace-with-sub2api-db-password
SUB2API_DB_MAX_OPEN_CONNS=20
SUB2API_DB_MAX_IDLE_CONNS=5
SUB2API_REDIS_HOST=sub2api-redis
SUB2API_REDIS_PASSWORD=replace-with-sub2api-redis-password
SUB2API_REDIS_DB=0
SUB2API_REDIS_MAXMEMORY=256mb
SUB2API_REDIS_POOL_SIZE=256
SUB2API_REDIS_MIN_IDLE_CONNS=5
GATEWAY_MAX_CONNS_PER_HOST=1024
GATEWAY_MAX_IDLE_CONNS=2560

# Behind the edge, Sub2API sees private Docker peers only. Trust those ranges
# and take the real client IP from Cloudflare's header.
SUB2API_TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
SUB2API_FORWARDED_IP_HEADERS=CF-Connecting-IP
SUB2API_URL_ALLOWLIST_ENABLED=false

# ===== Live pricing (CokeAI -> Sub2API group push) =====
# Prices pushed to Sub2API are CNY credit units; Sub2API's UI labels them USD.
# Retail starts PRICING_OFFICIAL_DISCOUNT_BPS below the official list price,
# but never below procurement cost + PRICING_MIN_MARGIN_BPS.
PRICING_OFFICIAL_DISCOUNT_BPS=1000
PRICING_MARKUP_BPS=12000
PRICING_MIN_MARGIN_BPS=1500
PRICING_MAX_INCREASE_BPS=3000
PRICING_SYNC_INTERVAL_MINUTES=60
PUBLIC_PRICE_URL=https://raw.githubusercontent.com/Wei-Shaw/model-price-repo/main/model_prices_and_context_window.json
FX_API_URL=https://open.er-api.com/v6/latest/USD
LOW_BALANCE_CNY=10
UPSTREAM_TIMEOUT_MS=180000

# ===== 易支付（Easypay）/ 支付宝 =====
EASYPAY_ENABLED=false
EASYPAY_GATEWAY=
EASYPAY_PID=
EASYPAY_KEY=
EASYPAY_SIGN_TYPE=MD5
# sorted (default) or concat, depending on your EasyPay provider.
EASYPAY_SIGN_MODE=sorted
# Optional full submit URL if the gateway does not expose /submit.php.
EASYPAY_SUBMIT_URL=
EASYPAY_ALIPAY_TYPE=alipay
# Optional shop risk caps (CNY). 0 = no cap. Set these before scaling.
EASYPAY_SHOP_MAX_ORDER_CNY=0
EASYPAY_SHOP_DAILY_MAX_CNY=0
# Keep the shop USDT-only until the EasyPay merchant is approved.
SHOP_EASYPAY_ENABLED=false

# ===== USDT TRC20 =====
USDT_ENABLED=false
USDT_TRC20_XPUB=
USDT_TRC20_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
USDT_TRONGRID_URL=https://api.trongrid.io
USDT_TRONGRID_API_KEY=
USDT_RATE_URL=https://api.coingecko.com/api/v3/simple/price?ids=tether&vs_currencies=cny
USDT_CONFIRMATIONS=19
# Payment window in minutes. The app hard-caps this at 10; unpaid orders expire.
USDT_QUOTE_MINUTES=10
USDT_MIN_AMOUNT=1
USDT_CNY_RATE=7.25
USDT_CNY_RATE_BUFFER_BPS=100
USDT_UNDERPAY_TOLERANCE_BPS=50
# Absolute tolerance in USDT, combined with the bps tolerance above.
USDT_AMOUNT_TOLERANCE=0.01
# Accept a late chain payment for this many hours after the quote expires.
USDT_LATE_GRACE_HOURS=24

# ===== Production smoke test (scripts/smoke-production.mjs) =====
# Create a throwaway key for a funded test user. SMOKE_REVOKED_API_KEY is a
# second key you deliberately revoked; leave blank to check only an unknown key.
SMOKE_API_KEY=
SMOKE_REVOKED_API_KEY=
SMOKE_MODEL=

# ===== CokeAI 小店（数字商品）=====
# Kill switch: false hides the storefront and returns 404. Tables/data stay intact.
SHOP_ENABLED=true
SHOP_FEED_URL=https://aibijia.org/live-data/products.json
SHOP_FEED_META_URL=https://aibijia.org/live-data/meta.json
SHOP_SYNC_INTERVAL_MINUTES=60
SHOP_MIN_MARGIN_BPS=1500
SHOP_MAX_COST_INCREASE_BPS=2500
SHOP_MISSING_RUNS_LIMIT=3
SHOP_ORDER_EXPIRE_MINUTES=30
SHOP_USDT_GRACE_HOURS=24
SHOP_MAX_QTY=5
SHOP_MAX_OPEN_ORDERS=3
SHOP_CUSTOMER_INPUT_RETENTION_DAYS=7
SHOP_SUPPORT_EMAIL=support@cokeai.cc.cd
