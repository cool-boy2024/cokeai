{
  "name": "CokeAI｜安全攻击告警（每 5 分钟）",
  "nodes": [
    {
      "parameters": {
        "content": "## 安全攻击告警\n\n每 5 分钟读取一次 `/api/internal/security/summary?mark=1`。\n\n摘要接口会在 `attack=true` 且 `should_alert=true` 时，由应用直接发送到后台配置的告警通道（企业微信 / 飞书 / Webhook / 邮箱）。\n\n本工作流不再推送任何 webhook，也不接触机器人地址或 SMTP 密码。\n\n同一波攻击由服务端冷却 key 控制，不会每 5 分钟重复推送。",
        "height": 240,
        "width": 360,
        "color": 3
      },
      "id": "45f45491-5c54-4871-a7ec-0e2688b4ac4e",
      "name": "使用说明",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -500,
        -70
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "2,7,12,17,22,27,32,37,42,47,52,57 * * * *"
            }
          ]
        }
      },
      "id": "f99870cb-4e0b-4f40-81b3-31012f7fd677",
      "name": "每 5 分钟",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -40,
        80
      ]
    },
    {
      "parameters": {
        "url": "http://app:3000/api/internal/security/summary?mark=1",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-internal-secret",
              "value": "={{ $env.INTERNAL_API_SECRET }}"
            }
          ]
        },
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "8ecb1759-2f51-4d01-bc2c-ab9b34ebce1c",
      "name": "读取安全摘要",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        210,
        80
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first()?.json || {};\nconst body = raw.body || raw;\n\nif (!body.available || !body.attack || !body.should_alert) {\n  return [];\n}\n\n// Delivery already happened inside the summary endpoint using the channel\n// configured at /admin/security/alerts. Keep the result for the execution log.\nreturn [{\n  json: {\n    ok: true,\n    alert_sent: Boolean(body.alert_sent),\n    window_count: body.window_count ?? 0,\n    threshold: body.threshold ?? 0,\n  },\n}];"
      },
      "id": "83a3a437-569d-473f-8939-a1cc4abbd237",
      "name": "判断攻击状态",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        80
      ]
    }
  ],
  "pinData": {
  },
  "connections": {
    "每 5 分钟": {
      "main": [
        [
          {
            "node": "读取安全摘要",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "读取安全摘要": {
      "main": [
        [
          {
            "node": "判断攻击状态",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
