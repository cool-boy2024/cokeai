{
  "name": "CokeAI｜每日对账与佣金解锁",
  "nodes": [
    {
      "parameters": {
        "content": "## CokeAI 每日对账\n\n每天北京时间 00:15 执行：\n1. 解锁已过退款观察期的推荐佣金\n2. 拉取最近 24 小时经营数据\n3. 通过 `ALERT_WEBHOOK_URL` 推送到 Slack / Discord 等兼容 Webhook\n\n导入后先在 n8n 中手动执行一次，确认没有报错，再启用工作流。",
        "height": 220,
        "width": 380,
        "color": 4
      },
      "id": "8f5f04f0-2c1a-4a75-a316-3518a4e6e731",
      "name": "使用说明",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-520, -80]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "15 0 * * *"
            }
          ]
        }
      },
      "id": "6d4ee98d-05ff-4fbd-9ebe-0c25bc7d10a1",
      "name": "每天 00:15",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-40, 80]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://app:3000/api/internal/commissions/mature",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-internal-secret",
              "value": "={{ $env.INTERNAL_API_SECRET }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "0a7b1c07-19d0-4f51-8633-3b4a7d6f8e11",
      "name": "解锁到期佣金",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [200, 80],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "url": "http://app:3000/api/internal/reports/daily",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-internal-secret",
              "value": "={{ $env.INTERNAL_API_SECRET }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "d8f5a9b2-71e4-46a8-8eb8-8e81965d3a40",
      "name": "拉取每日对账",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [430, 80]
    },
    {
      "parameters": {
        "jsCode": "const report = $input.first().json;\n\nconst formatCny = (micros) => `¥${(Number(micros || 0) / 1000000).toFixed(2)}`;\nconst lines = [\n  'CokeAI 每日对账（最近 24 小时）',\n  `收入：${report.revenue || formatCny(report.revenue_micros)}（${report.paid_orders || 0} 笔已支付）`,\n  `新增用户：${report.new_users || 0}`,\n  `请求：${report.requests || 0}，失败：${report.failures || 0}`,\n  `输入 Token：${report.input_tokens || 0}`,\n  `输出 Token：${report.output_tokens || 0}`,\n  `用户消耗：${formatCny(report.charged_micros)}`,\n  `上游成本：${formatCny(report.upstream_cost_micros)}`,\n  `用量毛利：${formatCny(report.gross_margin_micros)}`,\n  `超过 2 小时未处理订单：${report.pending_orders_older_than_2h || 0}`,\n  `待结算佣金：${formatCny(report.commission_available_micros)}`,\n].join('\\n');\n\nif (!$env.ALERT_WEBHOOK_URL) {\n  return [];\n}\n\nreturn [{ json: { text: lines, content: lines } }];"
      },
      "id": "25e0ac8f-9a43-4b73-b92c-f3d56d1baabb",
      "name": "格式化报告",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 80]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ALERT_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "5f4bdb67-63bb-45cb-99a8-513f9c08c9d1",
      "name": "推送对账摘要",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [890, 80],
      "onError": "continueRegularOutput"
    }
