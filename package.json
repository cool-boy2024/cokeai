{
  "name": "cokeai",
  "version": "1.0.0",
  "private": true,
  "description": "CokeAI - AI API 充值、Key 与用量控制台",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:zyanai": "esbuild scripts/sync-zyanai.ts --bundle --platform=node --format=cjs --target=node22 --tsconfig=tsconfig.json --external:pg-native --external:pg-cloudflare --outfile=zyanai-sync.cjs",
    "deploy:prod": "gh workflow run deploy.yml --ref main",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "shop:seed": "tsx scripts/shop-seed.ts",
    "shop:draft": "tsx scripts/shop-seed.ts --draft",
    "shop:content": "tsx scripts/export-shop-content.ts",
    "shop:publish": "node scripts/shop-publish.mjs",
    "shop:price": "node scripts/shop-price-adjust.mjs",
    "shop:sync": "tsx scripts/shop-sync.ts",
    "shop:zyanai": "tsx scripts/sync-zyanai.ts",
    "test:shop": "tsx scripts/test-shop.ts",
    "pricing:sync": "node scripts/pricing-sync.mjs",
    "verify:sub2api": "node scripts/verify-sub2api-config.mjs",
    "smoke:prod": "node scripts/smoke-production.mjs",
    "rollback:prepare": "node scripts/rollback-prepare.mjs",
    "test:shop:pay": "tsx scripts/test-shop-easypay.ts",
    "test:shop:usdt": "tsx scripts/test-shop-usdt.ts",
    "test:shop:sync": "tsx scripts/test-shop-sync.ts",
    "test:shop:manual": "tsx scripts/test-shop-manual-alipay.ts",
    "test:shop:categories": "tsx scripts/test-shop-categories.ts",
    "test:shop:preorder": "tsx scripts/test-shop-preorder.ts",
    "test:shop:sanitize": "tsx scripts/test-shop-sanitize.ts",
    "test:shop:payments": "tsx scripts/test-shop-payments.ts",
    "test:shop:balance": "tsx scripts/test-shop-balance.ts",
    "test:shop:analytics": "tsx scripts/test-shop-analytics.ts",
    "test:recharge-membership": "tsx scripts/test-recharge-membership.ts",
    "test:shop:variants": "tsx scripts/test-shop-variants.ts",
    "test:security": "tsx scripts/test-security-status.ts",
    "test:site-guards": "tsx scripts/test-site-guards.ts",
    "test:redirects": "tsx scripts/test-redirects.ts",
    "test:shop:copy": "tsx scripts/test-supplier-copy.ts",
    "test:visits": "tsx scripts/test-visits.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "bcryptjs": "3.0.3",
    "bs58check": "^4.0.0",
    "echarts": "^6.1.0",
    "geist": "^1.8.2",
    "gsap": "^3.15.0",
    "ioredis": "6.0.0",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "nodemailer": "^7.0.13",
    "pg": "8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "^2.18.2",
    "sharp": "^0.35.5",
    "stripe": "23.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/sanitize-html": "^2.16.2",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
